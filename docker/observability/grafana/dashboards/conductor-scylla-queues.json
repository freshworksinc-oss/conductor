        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(workflow_server_error_total{namespace=~\"$namespace\", class=\"ScyllaExecutionDAO\", methodName=~\"addPendingWorkflow|removePendingWorkflow|getPendingWorkflowCount|getInProgressTaskCount|addTaskToLimit|removeTaskFromLimit\"}[5m])) or vector(0)",
          "legendFormat": "__auto",
