{
  "title": "Conductor Scylla: queues and tasks",
  "uid": "conductor-scylla-queues",
  "description": "Queue depth, in-progress and task events for Conductor on Scylla, with WorkflowMonitor gauges on a single metrics pod.",
  "tags": [
    "conductor",
    "scylla"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "refresh": 1,
        "hide": 0,
        "current": {},
        "regex": ""
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(task_queue_depth, namespace)",
          "refId": "namespace"
        },
        "definition": "label_values(task_queue_depth, namespace)",
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "current": {},
        "hide": 0,
        "options": [],
        "regex": ""
      },
      {
        "name": "metrics_pod",
        "label": "Metrics pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(task_queue_depth{namespace=~\"$namespace\"}, pod)",
          "refId": "metrics_pod"
        },
        "definition": "label_values(task_queue_depth{namespace=~\"$namespace\"}, pod)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "options": [],
        "regex": ""
      },
      {
        "name": "scylla_pods",
        "label": "Scylla pods (domain metric)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(task_queue_depth_by_domain{namespace=~\"$namespace\"}, pod)",
          "refId": "scylla_pods"
        },
        "definition": "label_values(task_queue_depth_by_domain{namespace=~\"$namespace\"}, pod)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "options": [],
        "regex": ""
      },
      {
        "name": "tenant",
        "label": "Tenant (domain)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(task_queue_depth_by_domain{namespace=~\"$namespace\"}, domain)",
          "refId": "tenant"
        },
        "definition": "label_values(task_queue_depth_by_domain{namespace=~\"$namespace\"}, domain)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "options": [],
        "regex": ""
      },
