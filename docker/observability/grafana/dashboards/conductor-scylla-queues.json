    {
      "type": "stat",
      "title": "Scylla bookkeeping errors (5m)",
      "description": "Failed workflow_pending / task_def_limit writes or counts. Above 0 means workflow_running / task_in_progress may drift.",
      "id": 8,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
