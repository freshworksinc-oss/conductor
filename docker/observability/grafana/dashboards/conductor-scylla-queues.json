        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(task_queue_depth{namespace=~\"$namespace\"}, taskType)",
          "refId": "taskType"
        },
        "definition": "label_values(task_queue_depth{namespace=~\"$namespace\"}, taskType)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0,
        "options": [],
        "regex": ""
